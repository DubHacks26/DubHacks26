{
  "name": "dubhacks26",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development node app.js",
    "build": "next build",
    "start": "NODE_ENV=production node app.js",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "supabase:push": "npx supabase db push",
    "import:capture": "node scripts/import-capture.mjs",
    "import:sample-capture": "npm run supabase:push && npm run import:capture",
    "import:hashtags": "node scripts/import-hashtags.mjs",
    "backup:hashtags": "node scripts/backup-hashtags.mjs",
    "generate:hashtags": "node scripts/generate-hashtags.mjs",
    "backfill:embeddings": "node scripts/backfill-embeddings.mjs",
    "sync:hashtag-graph": "node scripts/sync-hashtag-graph.mjs",
    "enrich:sample-capture": "npm run import:sample-capture && npm run generate:hashtags"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@huggingface/transformers": "^4.3.1",
    "@mui/material": "^9.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-toastify": "^11.1.0",
    "supabase": "^2.121.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgvector": "^0.0.11",
    "@tailwindcss/turbopack": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
